DECLARE PLUGIN "rocq-zoo.plugin"

{

open Procq.Constr
open Procq.Prim
open Stdarg

let record_field =
  G_vernac.record_field

}

VERNAC ARGUMENT EXTEND zoo_global_base
| [ ] ->
    { Zoo_global.default_base }
| [ "⟨" qualid(theory) "⟩" ] ->
    { theory }
END

VERNAC ARGUMENT EXTEND zoo_global_kind'
| [ "iris" ] ->
    { Zoo_global.Iris }
| [ "zoo" ] ->
    { Zoo_global.Zoo }
END
VERNAC ARGUMENT EXTEND zoo_global_kind
| [ ] ->
    { Zoo_global.Zoo }
| [ ":" zoo_global_kind'(kind) ] ->
    { kind }
END

VERNAC ARGUMENT EXTEND zoo_global_field
| [ preident(name) ":" qualid(theory) constr_list(arguments) zoo_global_kind(kind) ] ->
    { Zoo_global.{ name; theory; arguments; kind } }
END

VERNAC ARGUMENT EXTEND zoo_global_spec
| [ zoo_global_base(base) binders(parameters) ":="
    "{" zoo_global_field_list_sep(fields, ";") "}"
  ] ->
    { Zoo_global.{ base; parameters; fields } }
END

VERNAC COMMAND EXTEND zoo_global
  CLASSIFIED AS SIDEFF
| [ "Zoo" "global" zoo_global_spec(spec) ] ->
    { Zoo_global.interp spec }
END

VERNAC ARGUMENT EXTEND zoo_derive_kind
| [ "Timeless" ] ->
    { Zoo_derive.Kind.Timeless }
| [ "Persistent" ] ->
    { Zoo_derive.Kind.Persistent }
END

VERNAC ARGUMENT EXTEND zoo_derive_modifier
| [ ] ->
    { Zoo_derive.Modifier.None }
| [ ":" "discarded" ] ->
    { Zoo_derive.Modifier.Discarded }
END

VERNAC COMMAND EXTEND zoo_derive
  CLASSIFIED AS SIDEFF
| #[ locality = Attributes.hint_locality_default_superglobal ]
  [ "Zoo" "derive" zoo_derive_kind(kind) "for" reference(id) zoo_derive_modifier(modifier) ] ->
    { Zoo_derive.interp ~locality ~kind ~modifier id }
END

VERNAC ARGUMENT EXTEND zoo_name_field
| [ record_field(fld) ] ->
    { fld }
END
VERNAC ARGUMENT EXTEND zoo_name_fields
| [ "{" zoo_name_field_list_sep(flds, ";") "}" ] ->
    { flds }
END

VERNAC COMMAND EXTEND zoo_name
  CLASSIFIED AS SIDEFF
| #[ locality = Attributes.hint_locality_default_superglobal ]
  [ "Zoo" "name" ":=" zoo_name_fields(flds) ] ->
    { Zoo_name.interp ~locality flds }
END
