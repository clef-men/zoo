DECLARE PLUGIN "rocq-zoo.plugin"

{

module Option =
  Stdlib.Option

open Procq.Constr
open Procq.Prim
open Stdarg

let record_field =
  G_vernac.record_field

let attribute_qualification =
  Attributes.bool_attribute ~name:"qualified"

}

VERNAC ARGUMENT EXTEND zoo_ident
| [ preident(id) ] ->
    { id }
| [ "Axiom" ] ->
    { "Axiom" }
| [ "CoFixpoint" ] ->
    { "CoFixpoint" }
| [ "Definition" ] ->
    { "Definition" }
| [ "Fixpoint" ] ->
    { "Fixpoint" }
| [ "Hypothesis" ] ->
    { "Hypothesis" }
| [ "Parameter" ] ->
    { "Parameter" }
| [ "Prop" ] ->
    { "Prop" }
| [ "Set" ] ->
    { "Set" }
| [ "SProp" ] ->
    { "SProp" }
| [ "Theorem" ] ->
    { "Theorem" }
| [ "Type" ] ->
    { "Type" }
| [ "Variable" ] ->
    { "Variable" }
| [ "by" ] ->
    { "by" }
| [ "exists" ] ->
    { "exists" }
| [ "forall" ] ->
    { "forall" }
| [ "using" ] ->
    { "using" }
END

VERNAC ARGUMENT EXTEND zoo_global_base
| [ ] ->
    { Zoo_global.default_base }
| [ "⟨" qualid(theory) "⟩" ] ->
    { theory }
END
VERNAC ARGUMENT EXTEND zoo_global_kind'
| [ "iris" ] ->
    { Zoo_global.Iris }
| [ "zoo" ] ->
    { Zoo_global.Zoo }
END
VERNAC ARGUMENT EXTEND zoo_global_kind
| [ ] ->
    { Zoo_global.Zoo }
| [ ":" zoo_global_kind'(kind) ] ->
    { kind }
END
VERNAC ARGUMENT EXTEND zoo_global_field
| [ zoo_ident(name) ":" qualid(theory) constr_list(arguments) zoo_global_kind(kind) ] ->
    { Zoo_global.{ name; theory; arguments; kind } }
END
VERNAC ARGUMENT EXTEND zoo_global_spec
| [ zoo_global_base(base) binders(parameters) ":="
    "{" zoo_global_field_list_sep(fields, ";") "}"
  ] ->
    { Zoo_global.{ base; parameters; fields } }
END

VERNAC COMMAND EXTEND zoo_global
  CLASSIFIED AS SIDEFF
| [ "Zoo" "global" zoo_global_spec(spec) ]
  ->
    { Zoo_global.interp spec }
END

VERNAC ARGUMENT EXTEND zoo_derive_kind
| [ "Timeless" ] ->
    { Zoo_derive.Kind.Timeless }
| [ "Persistent" ] ->
    { Zoo_derive.Kind.Persistent }
END
VERNAC ARGUMENT EXTEND zoo_derive_modifier
| [ ] ->
    { Zoo_derive.Modifier.None }
| [ ":" "discarded" ] ->
    { Zoo_derive.Modifier.Discarded }
END

VERNAC COMMAND EXTEND zoo_derive
  CLASSIFIED AS SIDEFF
| #[ locality = Attributes.hint_locality_default_superglobal ]
  [ "Zoo" "derive" zoo_derive_kind(kind) "for" reference(id) zoo_derive_modifier(modifier) ]
  ->
    { Zoo_derive.interp ~locality ~kind ~modifier id }
END

VERNAC ARGUMENT EXTEND zoo_name_field
| [ record_field(fld) ] ->
    { fld }
END
VERNAC ARGUMENT EXTEND zoo_name_fields
| [ "{" zoo_name_field_list_sep(flds, ";") "}" ] ->
    { flds }
END

VERNAC COMMAND EXTEND zoo_name
  CLASSIFIED AS SIDEFF
| #[ locality = Attributes.hint_locality_default_superglobal ]
  [ "Zoo" "name" ":=" zoo_name_fields(flds) ]
  ->
    { Zoo_name.interp ~locality flds }
END

VERNAC ARGUMENT EXTEND zoo_type_ident
| [ qualid(id) ] ->
    { id }
END
VERNAC ARGUMENT EXTEND zoo_type_mutability
| [ ] ->
    { Zoo_type.Immutable }
| [ "mutable" ] ->
    { Zoo_type.Mutable }
END
VERNAC ARGUMENT EXTEND zoo_type_declaration
| [ zoo_type_mutability(mut) "{" zoo_ident_list_sep(flds, ";") "}" ] ->
    { Zoo_type.Record (mut, flds) }
| [ "|" zoo_ident_list_sep(ctors, "|") ] ->
    { Zoo_type.Variant ctors }
END

VERNAC COMMAND EXTEND zoo_type
  CLASSIFIED BY { fun _ -> Vernacextend.VtSideff ([], VtNow) }
| #[ locality = Attributes.hint_locality; qualified = attribute_qualification ]
  [ "Zoo" "type" zoo_type_ident(id) ":=" zoo_type_declaration(decl) ]
  SYNTERP AS decls
    { let qualified = Option.value ~default:false qualified in
      Zoo_type.synterp ~locality ~qualified id decl
    }
  ->
    { Zoo_type.interp ~locality decls }
END
