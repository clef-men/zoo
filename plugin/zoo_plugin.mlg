DECLARE PLUGIN "rocq-zoo.plugin"

{

open Procq.Constr
open Procq.Prim
open Stdarg

}

VERNAC ARGUMENT EXTEND zoo_global_base
| [ ] ->
    { Zoo_global.default_base }
| [ "⟨" qualid(theory) "⟩" ] ->
    { theory }
END

VERNAC ARGUMENT EXTEND zoo_global_kind'
| [ "iris" ] ->
    { Zoo_global.Iris }
| [ "zoo" ] ->
    { Zoo_global.Zoo }
END
VERNAC ARGUMENT EXTEND zoo_global_kind
| [ ] ->
    { Zoo_global.Zoo }
| [ ":" zoo_global_kind'(kind) ] ->
    { kind }
END

VERNAC ARGUMENT EXTEND zoo_global_field
| [ preident(name) ":" qualid(theory) constr_list(arguments) zoo_global_kind(kind) ] ->
    { Zoo_global.{ name; theory; arguments; kind } }
END

VERNAC ARGUMENT EXTEND zoo_global_spec
| [ zoo_global_base(base) binders(parameters) ":="
    "{" zoo_global_field_list_sep(fields, ";") "}"
  ] ->
    { Zoo_global.{ base; parameters; fields } }
END

VERNAC COMMAND EXTEND zoo_global
  CLASSIFIED AS SIDEFF
| [ "Zoo" "global" zoo_global_spec(spec) ] ->
    { Zoo_global.main spec }
END
